<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.travelapp.controllers.LoginController">
    <SplitPane dividerPositions="0.7183734939759037" layoutY="1.0" orientation="VERTICAL" prefHeight="400.0" prefWidth="602.0">
