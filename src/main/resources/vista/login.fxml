                <font>
                    <Font size="18.0" />
                </font>
            </Label>
            <Label layoutX="257.0" layoutY="55.0" text="INICIAR SESIÓN" />
            <Label layoutX="140.0" layoutY="94.0" text="Email:" />
            <TextField fx:id="email" layoutX="374.0" layoutY="90.0" />
            <Label layoutX="139.0" layoutY="150.0" text="Contraseña:" />
            <PasswordField fx:id="contraseña" layoutX="374.0" layoutY="146.0" />
            <CheckBox fx:id="recuerdame" disable="true" layoutX="140.0" layoutY="199.0" mnemonicParsing="false" onAction="#onClickRecuerdame" text="Recuerdame" />
            <Button fx:id="inicioSesion" disable="true" layoutX="257.0" layoutY="238.0" mnemonicParsing="false" onAction="#onButtonClick" text="Iniciar Sesion" />
