<?xml version="1.0" encoding="UTF-8"?>

<!-- Pantalla de creación/edición de alojamientos -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.travelapp.controllers.EditarAlojamientoController"
            prefHeight="400.0"
            prefWidth="600.0">

    <top>
        <VBox spacing="5.0" BorderPane.alignment="CENTER">
            <children>
            <Label fx:id="labelTitulo" text="Crear Alojamiento"/>
                <Separator />
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </top>
    <center>
        <VBox spacing="20.0" BorderPane.alignment="CENTER">
            <children>
                <GridPane hgap="10" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Nombre:" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Dirección:" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtDireccion" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Fecha entrada:" GridPane.rowIndex="2"/>
                    <DatePicker fx:id="dpEntrada" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Fecha salida:" GridPane.rowIndex="3"/>
                    <DatePicker fx:id="dpSalida" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Precio total (€):" GridPane.rowIndex="4"/>
                    <TextField fx:id="txtPrecio" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                    <Label text="Valoración:" GridPane.rowIndex="5"/>
                    <ComboBox fx:id="cbValoracion" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                    <Label text="Viaje:" GridPane.rowIndex="6"/>
                    <ComboBox fx:id="cbViaje" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                </GridPane>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </center>
    <bottom>
        <HBox spacing="15.0" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="botonGuardar" text="Guardar" onAction="#guardar"/>
                <Button fx:id="botonCancelar" text="Cancelar" onAction="#cancelar"/>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </HBox>
    </bottom>
</BorderPane>