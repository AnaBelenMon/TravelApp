<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>


<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <VBox spacing="5.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Museos del Viaje" />
            <Separator />
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <VBox spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            <HBox spacing="10.0">
               <children>
                  <Button fx:id="botonNuevo" mnemonicParsing="false" onAction="#nuevoMuseo" text="Nuevo Museo" />
                  <Button fx:id="botonEditar" mnemonicParsing="false" onAction="#editarMuseo" text="Editar Museo" />
                  <Button fx:id="botonEliminar" mnemonicParsing="false" onAction="#eliminarMuseo" text="Eliminar Museo" />
                  <Pane HBox.hgrow="ALWAYS" />
                  <Button fx:id="botonVolver" mnemonicParsing="false" onAction="#volver" text="Volver" />
               </children>
            </HBox>
            <TableView fx:id="tablaMuseos">
              <columns>
                <TableColumn fx:id="colNombre" minWidth="-1.0" prefWidth="75.0" text="Nombre" />
                <TableColumn fx:id="colUbicacion" minWidth="-1.0" prefWidth="75.0" text="Ubicacion" />
                  <TableColumn fx:id="colPrecio" minWidth="-1.0" prefWidth="75.0" text="Precio" />
                  <TableColumn fx:id="colHorario" minWidth="-1.0" prefWidth="75.0" text="Horario" />
              </columns>
            </TableView>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
