<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.travelapp.controllers.EditarMuseoController">
    <top>
        <VBox spacing="5.0" BorderPane.alignment="CENTER">
            <children>
            <Label fx:id="labelTitulo" text="Crear Museo"/>
                <Separator />
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </top>
    <center>
        <VBox spacing="20.0" BorderPane.alignment="CENTER">
            <children>
            <GridPane hgap="10.0" vgap="15.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="130"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Nombre:" GridPane.rowIndex="0"/>
                <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Ubicación:" GridPane.rowIndex="1"/>
                <TextField fx:id="txtUbicacion" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Precio entrada (€):" GridPane.rowIndex="2"/>
                <TextField fx:id="txtPrecio" promptText="Ej: 12.50" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Horario:" GridPane.rowIndex="3"/>
                <TextField fx:id="txtHorario" promptText="09:00 - 18:00" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Descripción:" GridPane.rowIndex="4"/>
                <TextArea fx:id="txtDescripcion" prefRowCount="3" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
            </GridPane>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </center>
    <bottom>
        <HBox spacing="15.0" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="botonGuardar" mnemonicParsing="false" onAction="#guardar" text="Guardar" />
                <Button fx:id="botonCancelar" mnemonicParsing="false" onAction="#cancelar" text="Cancelar" />
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </HBox>
    </bottom>
</BorderPane>