<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.travelapp.controllers.ListaAlojamientosController">

    <top>
        <VBox spacing="5.0" BorderPane.alignment="CENTER">
            <Label text="Alojamientos del Viaje" />
            <Separator />
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </top>

    <center>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">
            <children>

                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnNuevo" onAction="#nuevoAlojamiento" text="Nuevo Alojamiento" />
                        <Button fx:id="btnEditar" onAction="#editarAlojamiento" text="Editar Alojamiento" />
                        <Button fx:id="btnEliminar" onAction="#eliminarAlojamiento" text="Eliminar Alojamiento" />
                        <Pane HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnVolver" onAction="#volver" text="Volver" />
                    </children>
                </HBox>

                <TableView fx:id="tablaAlojamientos">
                    <columns>
                        <TableColumn fx:id="colNombre" text="Nombre" />
                        <TableColumn fx:id="colDireccion" text="Dirección" />
                        <TableColumn fx:id="colEntrada" minWidth="-1.0" text="Entrada" />
                        <TableColumn fx:id="colSalida" minWidth="-1.0" text="Salida" />
                        <TableColumn fx:id="colPrecio" minWidth="-1.0" prefWidth="93.0" text="Precio Total (€)" />
                        <TableColumn fx:id="colValoracion" minWidth="-1.0" prefWidth="67.0" text="Valoración" />
                    </columns>
                </TableView>

            </children>

            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </center>

</BorderPane>
