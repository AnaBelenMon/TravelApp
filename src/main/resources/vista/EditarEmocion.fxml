<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.travelapp.controllers.EditarEmocionController">
    <top>
        <VBox spacing="5.0" BorderPane.alignment="CENTER">
            <children>
            <Label fx:id="labelTitulo"
                   text="Crear Emoción"/>
                <Separator />
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </top>
    <center>
        <VBox spacing="20.0" BorderPane.alignment="CENTER">
            <children>
            <GridPane hgap="10.0" vgap="15.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="130"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Tipo:" GridPane.rowIndex="0"/>
                <ComboBox fx:id="cmbTipo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Intensidad:" GridPane.rowIndex="1"/>
                <Slider fx:id="sliderIntensidad" min="1" max="10" value="5" showTickLabels="true" showTickMarks="true" majorTickUnit="1" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Fecha:" GridPane.rowIndex="2"/>
                <DatePicker fx:id="dpFecha" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Descripción:" GridPane.rowIndex="3"/>
                <TextArea fx:id="txtDescripcion" prefRowCount="3" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            </GridPane>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </center>
    <bottom>
        <HBox spacing="15.0" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="botonGuardar" mnemonicParsing="false" onAction="#guardar" text="Guardar" />
                <Button fx:id="botonCancelar" mnemonicParsing="false" onAction="#cancelar" text="Cancelar" />
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </HBox>
    </bottom>
</BorderPane>