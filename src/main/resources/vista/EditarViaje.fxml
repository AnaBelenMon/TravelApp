<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.travelapp.controllers.EditarViajeController">
    <top>
        <VBox spacing="5" alignment="CENTER">
            <children>
                <Label fx:id="labelTitulo" text="Crear Viaje" />
                <Separator />
            </children>
            <padding>
                <Insets top="20" bottom="20" left="20" right="20"/>
            </padding>
        </VBox>
    </top>
    <center>
        <VBox spacing="20" alignment="CENTER">
            <GridPane hgap="10" vgap="15">
                <columnConstraints>
                    <ColumnConstraints minWidth="140"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Nombre:" GridPane.rowIndex="0"/>
                <TextField fx:id="textNombre" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Fecha inicio:" GridPane.rowIndex="1"/>
                <DatePicker fx:id="fechaInicio" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Fecha fin:" GridPane.rowIndex="2"/>
                <DatePicker fx:id="fechaFin" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Tipo de viaje:" GridPane.rowIndex="3"/>
                <ComboBox fx:id="comboTipoViaje" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="País:" GridPane.rowIndex="4"/>
                <TextField fx:id="textPais" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <Label text="Ciudad:" GridPane.rowIndex="5"/>
                <TextField fx:id="textCiudad" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                <Label text="Presupuesto (€):" GridPane.rowIndex="6"/>
                <TextField fx:id="textPresupuesto" GridPane.columnIndex="1" GridPane.rowIndex="6" promptText="Ej: 1000"/>

                <Label text="Imagen portada:" GridPane.rowIndex="7"/>
                <TextField fx:id="textImagen" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

                <Label text="Notas generales (ruta):" GridPane.rowIndex="8"/>
                <TextArea fx:id="textNotas" prefRowCount="3" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
            </GridPane>


            <TitledPane text="Documentos del viaje" expanded="false">
                <content>
                    <VBox spacing="10">
                    <ListView fx:id="listaDocumentos" prefHeight="150"/>
                    <HBox spacing="10">
                        <children>
                            <Button text="Añadir documento" onAction="#añadirDocumento"/>
                            <Button text="Ver documento" onAction="#verDocumento"/>
                            <Button text="Eliminar documento" onAction="#eliminarDocumento"/>
                        </children>
                    </HBox>
                    </VBox>
                </content>
            </TitledPane>

            <TitledPane text="Transportes del viaje" expanded="false">
                <content>
                    <VBox spacing="10">
                        <ListView fx:id="listaTransportes" prefHeight="140"/>
                        <HBox spacing="10">
                            <children>
                                <Button text="Añadir transporte" onAction="#añadirTransporte"/>
                                <Button text="Editar transporte" onAction="#editarTransporte"/>
                                <Button text="Eliminar transporte" onAction="#eliminarTransporte"/>
                            </children>
                        </HBox>
                    </VBox>
                </content>
            </TitledPane>
            <padding>
                <Insets top="10" bottom="20" left="20" right="20"/>
            </padding>
        </VBox>
    </center>
    <bottom>
        <HBox spacing="15" alignment="CENTER">
            <children>
                <Button fx:id="botonGuardar" text="Guardar" onAction="#guardar"/>
                <Button fx:id="botonCancelar" text="Cancelar" onAction="#cancelar"/>
            </children>
            <padding>
                <Insets top="20" bottom="20" left="20" right="20"/>
            </padding>
        </HBox>
    </bottom>
</BorderPane>