<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            prefHeight="600" prefWidth="650">

    <top>
        <VBox spacing="5" alignment="CENTER">
            <children>
                <Label fx:id="labelTitulo" text="Crear Viaje" />
                <Separator />
            </children>
            <padding>
                <Insets top="20" bottom="20" left="20" right="20"/>
            </padding>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" alignment="CENTER">
            <children>

                <!-- FORMULARIO PRINCIPAL -->
                <GridPane hgap="10" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="120"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Nombre:" GridPane.rowIndex="0"/>
                    <TextField fx:id="textNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Fecha inicio:" GridPane.rowIndex="1"/>
                    <DatePicker fx:id="fechaInicio" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Fecha fin:" GridPane.rowIndex="2"/>
                    <DatePicker fx:id="fechaFin" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Tipo de viaje:" GridPane.rowIndex="3"/>
                    <ComboBox fx:id="comboTipoViaje" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="País:" GridPane.rowIndex="4"/>
                    <TextField fx:id="textPais" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="Ciudad:" GridPane.rowIndex="5"/>
                    <TextField fx:id="textCiudad" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <Label text="Presupuesto (€):" GridPane.rowIndex="6"/>
                    <TextField fx:id="textPresupuesto" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                    <Label text="Imagen portada (ruta):" GridPane.rowIndex="7"/>
                    <TextField fx:id="textImagen" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                    <Label text="Notas generales:" GridPane.rowIndex="8"/>
                    <TextArea fx:id="textNotas" prefRowCount="3"
                              GridPane.rowIndex="8" GridPane.columnIndex="1"/>
                </GridPane>

                <!-- DOCUMENTOS -->
                <TitledPane text="Documentos del viaje" expanded="false">
                    <content>
                        <VBox spacing="10">
                            <children>

                                <ListView fx:id="listaDocumentos" prefHeight="150"/>

                                <HBox spacing="10">
                                    <children>
                                        <Button text="Añadir documento" onAction="#añadirDocumento"/>
                                        <Button text="Ver documento" onAction="#verDocumento"/>
                                        <Button text="Eliminar documento" onAction="#eliminarDocumento"/>
                                    </children>
                                </HBox>

                            </children>
                        </VBox>
                    </content>
                </TitledPane>

                <!-- TRANSPORTES -->
                <TitledPane text="Transportes del viaje" expanded="false">
                    <content>
                        <VBox spacing="10">
                            <children>

                                <ListView fx:id="listaTransportes" prefHeight="150"/>

                                <HBox spacing="10">
                                    <children>
                                        <Button text="Añadir transporte" onAction="#añadirTransporte"/>
                                        <Button text="Editar transporte" onAction="#editarTransporte"/>
                                        <Button text="Eliminar transporte" onAction="#eliminarTransporte"/>
                                    </children>
                                </HBox>

                            </children>
                        </VBox>
                    </content>
                </TitledPane>

            </children>

            <padding>
                <Insets top="10" bottom="20" left="20" right="20"/>
            </padding>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="15" alignment="CENTER">
            <children>
                <Button fx:id="botonGuardar" text="Guardar" onAction="#guardar"/>
                <Button fx:id="botonCancelar" text="Cancelar" onAction="#cancelar"/>
            </children>
            <padding>
                <Insets top="20" bottom="20" left="20" right="20"/>
            </padding>
        </HBox>
    </bottom>

</BorderPane>
