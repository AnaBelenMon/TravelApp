<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.travelapp.controllers.EditarViajeController">
    <top>
        <VBox alignment="CENTER_LEFT" spacing="5">
            <children>
                <Label fx:id="labelTitulo" alignment="CENTER" text="Crear Viaje">
               <font>
                  <Font size="18.0" />
               </font></Label>
                <Separator />
            </children>
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
        </VBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="20">
            <GridPane hgap="10" vgap="15">
                <columnConstraints>
                    <ColumnConstraints minWidth="140" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>

                <Label text="Nombre:" GridPane.rowIndex="0" />
                <TextField fx:id="textNombre" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Destino: " GridPane.rowIndex="1" />
            <TextField fx:id="textDestino" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Fecha inicio:" GridPane.rowIndex="2" />
                <DatePicker fx:id="fechaInicio" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Fecha fin:" GridPane.rowIndex="3" />
                <DatePicker fx:id="fechaFin" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Tipo de viaje:" GridPane.rowIndex="4" />
                <ComboBox fx:id="comboTipoViaje" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <Label text="Presupuesto (€):" GridPane.rowIndex="5" />
                <TextField fx:id="textPresupuesto" promptText="Ej: 1000" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                <Label text="Notas:" GridPane.rowIndex="6" />
                <TextArea fx:id="textNotas" prefRowCount="3" GridPane.columnIndex="1" GridPane.rowIndex="6" />
            <rowConstraints>
               <RowConstraints />
               <RowConstraints minHeight="10.0" prefHeight="30.0" />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>
            <padding>
                <Insets bottom="20" left="20" right="20" top="10" />
            </padding>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="15">
            <children>
                <Button fx:id="botonGuardar" onAction="#guardar" text="Guardar" />
                <Button fx:id="botonCancelar" onAction="#cancelar" text="Cancelar" />
            </children>
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
        </HBox>
    </bottom>
</BorderPane>