<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.travelapp.controllers.ListaGastosController">

    <top>
        <VBox spacing="5.0" BorderPane.alignment="CENTER">
        <children>
        <Label text="Gastos del Viaje"/>
            <Separator/>
        </children>
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>
        </VBox>
    </top>

    <center>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">
            <HBox spacing="10.0">
                <children>
                <Button fx:id="btnNuevo" mnemonicParsing="false" text="Nuevo Gasto" onAction="#nuevoGasto"/>
                <Button fx:id="btnEditar" mnemonicParsing="false" text="Editar Gasto" onAction="#editarGasto"/>
                <Button fx:id="btnEliminar" mnemonicParsing="false" text="Eliminar Gasto" onAction="#eliminarGasto"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnVolver" mnemonicParsing="false" text="Volver" onAction="#volver"/>
            </children>
            </HBox>

            <TableView fx:id="tablaGastos" >
                <columns>
                    <TableColumn fx:id="colConcepto" text="Concepto"/>
                    <TableColumn fx:id="colCategoria" text="Categoría" />
                    <TableColumn fx:id="colFecha" text="Fecha" />
                    <TableColumn fx:id="colImporte" text="Importe (€)" />
                </columns>

            </TableView>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </center>

</BorderPane>