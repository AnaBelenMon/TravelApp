<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.travelapp.controllers.ListaActividadesController">
    <top>
        <VBox spacing="5.0" BorderPane.alignment="CENTER">
            <Label text="Actividades del Viaje" />
            <Separator />
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </top>
    <center>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">

            <HBox spacing="10.0">
                <Button fx:id="btnNueva" mnemonicParsing="false" onAction="#nuevaActividad" text="Nueva Actividad" />
                <Button fx:id="btnEditar" mnemonicParsing="false" onAction="#editarActividad" text="Editar Actividad" />
                <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminarActividad" text="Eliminar Actividad" />
                <Pane HBox.hgrow="ALWAYS" />
                <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#volver" text="Volver" />
            </HBox>

            <TableView fx:id="tablaActividades">
                <columns>
                    <TableColumn fx:id="colNombre" text="Nombre" />
                    <TableColumn fx:id="colFecha" text="Fecha" />
                    <TableColumn fx:id="colCategoria" text="Categoría" />
                    <TableColumn fx:id="colCoste" text="Coste (€)" />
                    <TableColumn fx:id="colDescripcion" text="Descripción" />
                    <TableColumn fx:id="colDuracion" text="Duración (min)" />
                    <TableColumn fx:id="colUbicacion" text="Ubicación" />
                    <TableColumn fx:id="colValoracion" text="Valoración" />
                    <TableColumn fx:id="colReservada" text="Reservada" />
                </columns>
            </TableView>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </center>

</BorderPane>
