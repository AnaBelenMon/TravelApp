<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.travelapp.controllers.EditarActividadController"
            prefHeight="500" prefWidth="650">
    <top>
        <VBox spacing="5.0" BorderPane.alignment="CENTER">
            <Label text="Actividades del Viaje" />
            <Separator />
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </top>
    <center>
        <GridPane hgap="10" vgap="12" alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints prefWidth="150"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Nombre:" GridPane.rowIndex="0"/>
            <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Fecha:" GridPane.rowIndex="1"/>
            <DatePicker fx:id="dpFecha" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Categoría:" GridPane.rowIndex="2"/>
            <ComboBox fx:id="cmbCategoria" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Coste:" GridPane.rowIndex="3"/>
            <TextField fx:id="txtCoste" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Descripción:" GridPane.rowIndex="4"/>
            <TextArea fx:id="txtDescripcion" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Duración:" GridPane.rowIndex="5"/>
            <TextField fx:id="txtDuracion" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

            <Label text="Ubicación:" GridPane.rowIndex="6"/>
            <TextField fx:id="txtUbicacion" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

            <Label text="Valoración:" GridPane.rowIndex="7"/>
            <ComboBox fx:id="cmbValoracion" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

            <Label text="Reservada:" GridPane.rowIndex="8"/>
            <CheckBox fx:id="chkReservada" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </GridPane>
    </center>
    <bottom>
        <HBox spacing="15" alignment="CENTER">
            <children>
                <Button text="Guardar" onAction="#guardar"/>
                <Button text="Cancelar" onAction="#cancelar"/>
            </children>
            <padding>
                <Insets top="20" bottom="20"/>
            </padding>
        </HBox>
    </bottom>

</BorderPane>