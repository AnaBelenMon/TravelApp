<?xml version="1.0" encoding="UTF-8"?>

<!-- Pantalla de edición/creación de actividades -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.travelapp.controllers.EditarActividadController" prefHeight="400.0" prefWidth="600.0">
    <top>
        <VBox spacing="5.0" BorderPane.alignment="CENTER">
            <children>
            <Label fx:id="labelTitulo" text="Crear Actividad" />
                <Separator />
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </top>
    <center>
        <VBox spacing="20.0" BorderPane.alignment="CENTER">
            <children>
                <GridPane hgap="10" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Nombre:" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Fecha:" GridPane.rowIndex="1"/>
                    <DatePicker fx:id="dpFecha" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Categoría:" GridPane.rowIndex="2" />
                <ComboBox fx:id="cmbCategoria" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Coste (€):" GridPane.rowIndex="3"/>
                    <TextField fx:id="txtCoste" promptText="Ej: 25.50" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <Label text="Descripción:" GridPane.rowIndex="4" />
                <TextArea fx:id="txtDescripcion" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                    <Label text="Duración (minutos):" GridPane.rowIndex="5" />
                    <TextField fx:id="txtDuracion" promptText="Ej: 120" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                    <Label text="Ubicación:" GridPane.rowIndex="6"/>
                    <TextField fx:id="txtUbicacion" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                    <Label text="Valoración:" GridPane.rowIndex="7"/>
                    <ComboBox fx:id="cmbValoracion" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

                    <Label text="Reservada:" GridPane.rowIndex="8"/>
                    <CheckBox fx:id="chkReservada" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
                </GridPane>
            </children>
        </VBox>
    </center>
    <bottom>
        <HBox spacing="15">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <children>
                <Button fx:id="botonGuardar" text="Guardar" onAction="#guardar"/>
                <Button fx:id="botonCancelar" text="Cancelar" onAction="#cancelar"/>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </HBox>
    </bottom>
</BorderPane>