<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>


<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.travelapp.controllers.ListaObrasController">
   <top>
      <VBox spacing="5.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Obras del Museo" />
            <Separator />
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <HBox>
               <children>
                  <Button fx:id="botonNuevo" mnemonicParsing="false" onAction="#nuevaObra" text="Nueva Obra" />
                  <Button fx:id="botonEditar" mnemonicParsing="false" onAction="#editarObra" text="Editar Obra" />
                  <Button fx:id="botonEliminar" mnemonicParsing="false" onAction="#eliminarObra" text="Eliminar Obra" />
                  <Pane HBox.hgrow="ALWAYS" />
                  <Button fx:id="botonVolver" mnemonicParsing="false" onAction="#volver" text="Volver" />
               </children>
            </HBox>
            <TableView fx:id="tablaObras">
              <columns>
                <TableColumn fx:id="colNombre" minWidth="-1.0" prefWidth="75.0" text="Nombre" />
                <TableColumn fx:id="colAutor" minWidth="-1.0" prefWidth="75.0" text="Autor" />
                  <TableColumn fx:id="colAno" minWidth="-1.0" prefWidth="75.0" text="Año" />
              </columns>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>
