<AnchorPane prefHeight="225.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.travelapp.controllers.componentes.TarjetaViajeController">
   <children>
      <HBox alignment="CENTER" prefHeight="18.0" prefWidth="600.0">
         <children>
            <Label text="Viaje">
