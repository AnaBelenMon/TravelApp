               </font>
               <HBox.margin>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </HBox.margin>
            </Label>
         </children>
      </HBox>
      <VBox layoutY="67.0" prefHeight="159.0" prefWidth="600.0">
         <children>
            <Label text="Label">
               <VBox.margin>
                  <Insets bottom="10.0" left="20.0" right="10.0" top="10.0" />
               </VBox.margin></Label>
            <Label text="Label">
               <VBox.margin>
                  <Insets bottom="10.0" left="20.0" right="10.0" top="10.0" />
               </VBox.margin></Label>
            <Label text="Label">
               <VBox.margin>
                  <Insets bottom="10.0" left="20.0" right="10.0" top="10.0" />
               </VBox.margin></Label>
            <Label text="Label">
               <VBox.margin>
                  <Insets bottom="20.0" left="20.0" right="10.0" top="10.0" />
               </VBox.margin></Label>
            <HBox alignment="CENTER" prefHeight="7.0" prefWidth="600.0">
               <children>
                  <Button fx:id="verViaje" mnemonicParsing="false" onAction="#onclickButtonVerViaje" text="Ver viaje">
                     <HBox.margin>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </HBox.margin>
                  </Button>
                  <Button fx:id="eliminar" mnemonicParsing="false" onAction="#onclickButtonEliminar" text="Eliminar" />
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
